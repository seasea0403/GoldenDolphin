  lines:
  - id: 1
    speakerName: 
    speakingContent: "\u4F60\u5728\u5929\u5802\u7ECF\u8425\u4E86\u591A\u5C11\u5929\uFF1F\u8FD9\u4E0D\u91CD\u8981\u3002"
    charImage: {fileID: 0}
  - id: 2
    speakerName: 
    speakingContent: "\u770B\u770B\u8FD9\u91CC\u7684\u539F\u4F4F\u6C11\u5929\u4F7F\uFF0C\u7942\u4EEC\u6709\u7FC5\u8180\uFF0C\u6709\u9B54\u6CD5\u3001\u6709\u795E\u5723\u7684\u5916\u8863\uFF0C\u4F60\u4E3A\u7942\u4EEC\u63D0\u4F9B\u6765\u81EA\u51E1\u754C\u7684\u9910\u70B9\uFF0C\u7942\u4EEC\u56E0\u4F60\u53D8\u5F97\u66F4\u6E29\u67D4\u3001\u66F4\u6177\u6168\uFF0C\u66F4\u4E50\u5584\u597D\u65BD\uFF0C\u66F4\u662F...\u6C38\u4E0D\u6EE1\u8DB3\u3002"
    charImage: {fileID: 0}
  - id: 3
    speakerName: 
    speakingContent: "\u7942\u4EEC\u8BF4\uFF0C\u5929\u4E0A\u6CA1\u6709\u9ED1\u591C\uFF0C\u7075\u5575\u98DF\u5802\u6709\u4EC0\u4E48\u6253\u70CA\u7684\u5FC5\u8981\u5462\uFF1F"
    charImage: {fileID: 0}
