  m_Script: {fileID: 11500000, guid: 1d1a8ab11dc293247bd037af83258ad0, type: 3}
  m_Name: Ending0
  m_EditorClassIdentifier: 
  lines:
  - id: 1
    speakerName: 
    speakingContent: "\u4F60\u786E\u4FE1\u81EA\u5DF1\u5DF2\u7ECF\u6765\u5230\u4E86\u6B7B\u540E\u7684\u5730\u65B9\u3002"
    charImage: {fileID: 0}
  - id: 2
    speakerName: 
    speakingContent: "\u201C\u6211\u5230\u5E95\u662F\u8C01\uFF1F\u7A76\u7ADF\u4ECE\u54EA\u6765\uFF0C\u53C8\u8981\u53BB\u5F80\u4F55\u5904\uFF1F\u201D"
    charImage: {fileID: 0}
  - id: 3
    speakerName: 
    speakingContent: "\u5F85\u5728\u8FD9\u91CC\u7684\u8FD9\u6BB5\u65F6\u95F4\uFF0C\u4F60\u5DE6\u601D\u53F3\u60F3\u591C\u4E0D\u80FD\u5BD0\uFF0C\u5730\u72F1\u706B\u4E0D\u65AD\u707C\u70E7\u7740\u4F60\u7684\u7406\u6027\u548C\u610F\u5FD7\uFF1B\u7F6A\u4EBA\u548C\u6076\u9B54\u4EEC\u5728\u4F60\u8033\u8FB9\u5486\u54EE\u7740\uFF0C\u5B83\u4EEC\u5728\u544A\u8BC9\u4F60\u4F60\u4E0E\u4ED6\u4EEC\u540C\u5728\u3002"
    charImage: {fileID: 0}
  - id: 4
    speakerName: 
    speakingContent: "\u4EBA\u6B7B\u540E\u4E0D\u8FC7\u5982\u6B64\uFF0C\u751F\u4E5F\u4E0D\u8FC7\u5982\u6B64...\u8C01\u80FD\u4FDD\u8BC1\u81EA\u5DF1\u7684\u7075\u9B42\u6B7B\u540E\u8FD8\u662F\u5E72\u5E72\u51C0\u51C0\u5462\uFF1F\u7559\u5728\u8FD9\u91CC\uFF0C\u53EF\u4EE5\u8DE8\u8FC7\u7F6A\u6076\u7684\u95E8\u69DB\uFF0C\u53EF\u4EE5\u9003\u8FC7\u6C38\u6052\u7684\u5211\u7F5A\u3002"
    charImage: {fileID: 0}
  - id: 5
    speakerName: 
    speakingContent: "\u4F60\u653E\u5F03\u4E86\u8FFD\u5BFB\u751F\u7684\u610F\u4E49\uFF0C"
    charImage: {fileID: 0}
  - id: 6
    speakerName: 
    speakingContent: "\u6B7B\u4EA1\u662F\u5F88\u5BFB\u5E38\u7684\u4E1C\u897F\uFF0C\u6B7B\u4EA1\u662F\u51C9\u723D\u7684\u590F\u591C\u3002"
    charImage: {fileID: 0}
