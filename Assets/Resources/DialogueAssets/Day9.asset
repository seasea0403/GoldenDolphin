  - id: 6
    speakerName: "\u6211"
    speakingContent: "\u60A8\u662F\u4E0D\u662F\u6709\u4E9B\u56F0\u96BE\uFF1F\u4E0D\u4ECB\u610F\u7684\u8BDD\uFF0C\u6211\u53EF\u4EE5\u7ED9\u4F60\u505A\u7897\u5403\u7684\uFF0C\u514D\u8D39\u7684\u54E6\u3002"
    charImage: {fileID: 0}
  - id: 7
    speakerName: "\u201C\u9B3C\u201D"
    speakingContent: "\u6C42...\u89C1..."
    charImage: {fileID: 21300000, guid: ffe918aa851f4374e8a9283d81de52b7, type: 3}
  - id: 8
    speakerName: "\u201C\u9B3C\u201D"
    speakingContent: "\u6211\u9519\u4E86...\u6211\u9519\u4E86..."
    charImage: {fileID: 21300000, guid: ffe918aa851f4374e8a9283d81de52b7, type: 3}
  - id: 9
    speakerName: "\u6211"
    speakingContent: "\uFF08\u8FD9\u4E2A\u8001\u7237\u7237\u662F\u4E0D\u662F\u7CBE\u795E\u4E0A\u6709\u4E9B\u95EE\u9898\uFF0C\u5148\u5E26\u4ED6\u5165\u5EA7\u5427\u3002"
    charImage: {fileID: 0}
  - id: 10
    speakerName: "\u6211"
    speakingContent: "\u60A8\u7A0D\u7B49\u4E00\u4E0B\uFF0C\u6211\u53BB\u7ED9\u60A8\u716E\u7897\u8089\u6C64\u3002"
    charImage: {fileID: 0}
  - id: 11
    speakerName: "\u201C\u9B3C\u201D"
    speakingContent: "\u4F60...\u6709\u6CA1\u6709\u89C1\u8FC7\u5C0F\u51E4..."
    charImage: {fileID: 21300000, guid: ffe918aa851f4374e8a9283d81de52b7, type: 3}
  - id: 12
    speakerName: "\u6211"
    speakingContent: "\uFF08\u8FD9\u4E24\u5929\u6CA1\u542C\u8FC7\u8FD9\u4E2A\u540D\u5B57\uFF0C\u66F4\u522B\u8BF4\u6211\u4E4B\u524D\u7684\u8BB0\u5FC6\u90FD\u6CA1\u6709\u4E86\u3002"
    charImage: {fileID: 0}
  - id: 13
    speakerName: "\u6211"
    speakingContent: "\u62B1\u6B49\uFF0C\u6211\u6CA1\u6709\u542C\u8FC7\u3002"
    charImage: {fileID: 0}
  - id: 14
    speakerName: "\u201C\u9B3C\u201D"
    speakingContent: "\u6211...\u6211\u8981\u56DE\u5230\u8FC7\u53BB..."
    charImage: {fileID: 21300000, guid: ffe918aa851f4374e8a9283d81de52b7, type: 3}
  - id: 15
    speakerName: "\u6211"
    speakingContent: "\uFF08\u5B8C\u5168\u4EA4\u6D41\u4E0D\u4E86\u554A..."
    charImage: {fileID: 0}
  - id: 16
    speakerName: "\u67D0\u98DF\u5BA2"
    speakingContent: "\u522B\u770B\u8FD9\u8001\u5934\u795E\u795E\u53E8\u53E8\u7684\uFF0C\u4ED6\u53EF\u662F\u76F8\u5F53\u957F\u5BFF\u5462\u3002"
    charImage: {fileID: 0}
  - id: 17
    speakerName: "\u67D0\u98DF\u5BA2"
    speakingContent: "\u6CA1\u8BB0\u9519\u7684\u8BDD\uFF0C\u4ED6\u597D\u50CF\u4E00\u767E\u4E94\u5341\u5C81\u4EE5\u4E0A\u4E86\uFF1F"
    charImage: {fileID: 0}
  - id: 18
    speakerName: "\u6211"
    speakingContent: "\u4E00\u767E\u4E94\u5341\u5C81\uFF01"
    charImage: {fileID: 0}
  - id: 19
    speakerName: "\u67D0\u98DF\u5BA2"
    speakingContent: "\u662F\u554A\uFF0C\u8EAB\u4F53\u5EB7\u5065\u7740\u5462\uFF0C\u9644\u8FD1\u7684\u4EBA\u90FD\u53EB\u4ED6\u8001\u9B3C\u3002"
    charImage: {fileID: 0}
  - id: 20
    speakerName: "\u201C\u9B3C\u201D"
    speakingContent: "\u5C0F\u9F99...\u5C0F\u51E4..."
    charImage: {fileID: 21300000, guid: ffe918aa851f4374e8a9283d81de52b7, type: 3}
  - id: 21
    speakerName: "\u6211"
    speakingContent: "\u60A8\u662F\u5728\u627E\u5BB6\u4EBA\u5417\uFF1F"
    charImage: {fileID: 0}
  - id: 22
    speakerName: "\u201C\u9B3C\u201D"
    speakingContent: "\u5BF9\uFF0C\u5BF9\uFF01\u4FFA\u513F\u5B50\u3001\u4FFA\u5973\u513F\u3001\u4FFA\u5AB3\u5987\u513F...\u627E\u4E0D\u5230\uFF0C\u4FFA\u51FA\u4E0D\u53BB\u4E86..."
    charImage: {fileID: 21300000, guid: ffe918aa851f4374e8a9283d81de52b7, type: 3}
  - id: 23
    speakerName: "\u6211"
    speakingContent: "\uFF08\u5171\u60C5\uFF09\u6211\u4E5F\u8054\u7CFB\u4E0D\u5230\u5BB6\u4EBA\u4E86\uFF0C\u6211\u751A\u81F3\u5FD8\u4E86\u4ED6\u4EEC\u53EB\u4EC0\u4E48\u540D\u5B57\uFF0C\u73B0\u5728\u662F\u5426\u62C5\u5FC3\u6211\u3002"
    charImage: {fileID: 0}
  - id: 24
    speakerName: "\u6211"
    speakingContent: "\u6240\u4EE5\u5982\u679C\u60A8\u6709\u9700\u8981\u7684\u8BDD\u8BF7\u5E38\u6765\uFF0C\u6211\u53EF\u4EE5\u7ED9\u60A8\u63D0\u4F9B\u98DF\u7269\u548C\u5E2E\u52A9\uFF0C\u5982\u679C\u6709\u60A8\u5BB6\u4EBA\u7684\u7EBF\u7D22\uFF0C\u4E5F\u4E00\u5B9A\u4F1A\u7B2C\u4E00\u65F6\u95F4\u901A\u77E5\u60A8\u3002"
    charImage: {fileID: 0}
  - id: 25
    speakerName: "\u201C\u9B3C\u201D"
    speakingContent: "\u597D...\u597D..."
