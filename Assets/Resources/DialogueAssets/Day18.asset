  lines:
  - id: 1
    speakerName: "\u6211"
    speakingContent: "\uFF08\u8FD9\u6BB5\u65F6\u95F4\u6211\u4E5F\u6709\u4E9B\u7709\u76EE\u4E86\uFF0C\u5173\u4E8E\u201C\u5927\u4EBA\u7269\u201D\u89C1\u5230\u4E86\u81EA\u5DF1\u6B7B\u53BB\u7684\u7236\u6BCD\u8FD9\u4EF6\u4E8B..."
    charImage: {fileID: 0}
  - id: 2
    speakerName: "\u6211"
    speakingContent: "\uFF08\u8FD9\u91CC\u5E76\u4E0D\u662F\u771F\u7684\u4EBA\u95F4\uFF0C\u8FD9\u6837\u4E00\u6765\u8001\u7237\u7237\u7684\u5E74\u9F84\u4E5F\u5C31\u8BF4\u5F97\u901A\u4E86\u3002"
    charImage: {fileID: 0}
  - id: 3
    speakerName: "\u6211"
    speakingContent: "\uFF08\u4F46\u7A76\u7ADF\u662F\u4EC0\u4E48\u8BA9\u4ED6\u505C\u7559\u4E86\u8FD9\u4E48\u4E45..."
