  - id: 4
    speakerName: "\u201C\u9B3C\u201D"
    speakingContent: "\u5B69\u5B50\uFF0C\u5B69\u5B50\u3002"
    charImage: {fileID: 21300000, guid: ffe918aa851f4374e8a9283d81de52b7, type: 3}
  - id: 5
    speakerName: "\u6211"
    speakingContent: "\u8001\u7237\u7237\uFF1F\u60A8\u8BA4\u5F97\u6211\u4E86\uFF01"
    charImage: {fileID: 0}
  - id: 6
    speakerName: "\u201C\u9B3C\u201D"
    speakingContent: "\u544A\u8BC9\u4F60\u4E00\u4E2A\u3001\u4E00\u4E2A\u597D\u6D88\u606F\u3002"
    charImage: {fileID: 21300000, guid: ffe918aa851f4374e8a9283d81de52b7, type: 3}
  - id: 7
    speakerName: "\u6211"
    speakingContent: "\u4EC0\u4E48\u597D\u6D88\u606F\uFF1F"
    charImage: {fileID: 0}
  - id: 8
    speakerName: "\u201C\u9B3C\u201D"
    speakingContent: "\u4FFA\u3001\u4FFA\u8981\u8D70\u4E86\u3002"
    charImage: {fileID: 21300000, guid: ffe918aa851f4374e8a9283d81de52b7, type: 3}
  - id: 9
    speakerName: "\u6211"
    speakingContent: "\u60A8\u8FD9\u662F\u627E\u5230\u5BB6\u4EBA\u4E86\u5417\uFF0C\u662F\u8981\u56DE\u5BB6\u4E86\uFF1F"
    charImage: {fileID: 0}
  - id: 10
    speakerName: "\u201C\u9B3C\u201D"
    speakingContent: "\u4E0D\uFF0C\u4E0D\uFF0C\u662F\u53BB\u522B\u7684\u5730\u65B9...\u4FFA\u4E0D\u77E5\u9053\u7684\u5730\u65B9\u3002"
    charImage: {fileID: 21300000, guid: ffe918aa851f4374e8a9283d81de52b7, type: 3}
  - id: 11
    speakerName: "\u6211"
    speakingContent: "\u60A8\u8FD9\u662F..."
    charImage: {fileID: 0}
  - id: 12
    speakerName: "\u201C\u9B3C\u201D"
    speakingContent: "\u8001\u3001\u8001\u5566...\u7EC8\u4E8E\uFF0C\u6CA1\u4EBA\u8BB0\u5F97\u8001\u3001\u8001\u9B3C\u4E86\u3002"
    charImage: {fileID: 21300000, guid: ffe918aa851f4374e8a9283d81de52b7, type: 3}
  - id: 13
    speakerName: "\u201C\u9B3C\u201D"
    speakingContent: "\u8001\u9B3C\u3001\u4E0D\u662F\u3001\u9B3C\u602A\u3001\u4F20\u8BF4..."
    charImage: {fileID: 21300000, guid: ffe918aa851f4374e8a9283d81de52b7, type: 3}
  - id: 14
    speakerName: "\u201C\u9B3C\u201D"
    speakingContent: "\u65F6\u4EE3\u3001\u5FD8\u8BB0\uFF0C\u8001\u9B3C...\u9003\u5175..."
    charImage: {fileID: 21300000, guid: ffe918aa851f4374e8a9283d81de52b7, type: 3}
  - id: 15
    speakerName: "\u201C\u9B3C\u201D"
    speakingContent: "\u53BB\u3001\u6765\u53BB\u8D70..."
    charImage: {fileID: 21300000, guid: ffe918aa851f4374e8a9283d81de52b7, type: 3}
  - id: 16
    speakerName: "\u6211"
    speakingContent: "\uFF08\u88AB\u4EBA\u4EEC\u5F53\u6210\u9B3C\u602A\u4F20\u8BF4\u4E00\u767E\u4E94\u5341\u5E74\uFF0C\u4EBA\u95F4\u7684\u4E0B\u4E00\u7AD9\u4F1A\u662F\u54EA\u91CC..."
    charImage: {fileID: 0}
  - id: 17
    speakerName: "\u201C\u9B3C\u201D"
    speakingContent: "\u5C0F\u51E4\u3001\u6B4C\u3001\u6559\u4F60\u5531..."
    charImage: {fileID: 21300000, guid: ffe918aa851f4374e8a9283d81de52b7, type: 3}
  - id: 18
    speakerName: "\u201C\u9B3C\u201D"
    speakingContent: "\u4F60\u8BF4\u3001\u7EA2\u5C18\u6709\u4E00\u6BB5\u5FD8\u4E0D\u6389\u7684\u6101\u5440\uFF0C\u5F80\u4E8B\u5982\u70DF\u6563\u3001\u5374\u8FD8\u6B8B\u7559..."
    charImage: {fileID: 21300000, guid: ffe918aa851f4374e8a9283d81de52b7, type: 3}
  - id: 19
    speakerName: "\u201C\u9B3C\u201D"
    speakingContent: "\u4E16\u95F4\u805A\u3001\u6563\u79BB\u5408...\u4ECE\u6765\u90FD\u4E0D\u7531\u4EBA\u6C42..."
    charImage: {fileID: 21300000, guid: ffe918aa851f4374e8a9283d81de52b7, type: 3}
  - id: 20
    speakerName: "\u201C\u9B3C\u201D"
    speakingContent: "\u4E00\u7247\u53F6\u5728\u98D8\u96F6\u554A...\u6CA1\u6709\u76EE\u7684\u6F02\u6D41..."
