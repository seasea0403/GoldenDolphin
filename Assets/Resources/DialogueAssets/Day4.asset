  m_Script: {fileID: 11500000, guid: 1d1a8ab11dc293247bd037af83258ad0, type: 3}
  m_Name: Day4
  m_EditorClassIdentifier: 
  lines:
  - id: 1
    speakerName: "\u6211"
    speakingContent: "\uFF08\u5728\u8FD9\u91CC\u5DE5\u4F5C\u8FD8\u662F\u633A\u6E05\u95F2\u7684\uFF0C\u6BCF\u5929\u6765\u7684\u4EBA\u4E5F\u4E0D\u591A\uFF0C\u751A\u81F3\u6709\u4E9B\u8FC7\u4E8E\u5B89\u9759\u4E86\u3002"
    charImage: {fileID: 0}
  - id: 2
    speakerName: "\u6211"
    speakingContent: "\uFF08\u8FD9\u51E0\u5929\u4E5F\u8BD5\u8FC7\u95EE\u6765\u5F80\u7684\u98DF\u5BA2\u95EE\u9898\uFF0C\u8FD8\u7528\u5947\u602A\u7684\u773C\u795E\u770B\u7740\u6211\u3002"
    charImage: {fileID: 0}
  - id: 3
    speakerName: "\u6211"
    speakingContent: "\uFF08\u4E0D\u5151\uFF01\u600E\u4E48\u5C31\u81EA\u52A8\u4EE3\u5165\u5168\u804C\u6253\u5DE5\u4EBA\u4E86\uFF1F\u660E\u660E\u8FD9\u5BB6\u5E97\u4EE5\u524D\u548C\u6211\u6CA1\u6709\u4EFB\u4F55\u5173\u7CFB.."
    charImage: {fileID: 0}
  - id: 4
    speakerName: "\u6211"
    speakingContent: "\uFF08\u53CD\u6B63\u4E5F\u6CA1\u51E0\u4E2A\u5BA2\u4EBA\uFF0C\u4E0D\u5982\u4E0B\u5348\u95ED\u5E97\u5728\u9644\u8FD1\u591A\u6253\u63A2\u6253\u63A2\u5427\u3002"
    charImage: {fileID: 0}
  - id: 5
    speakerName: "\u6211"
    speakingContent: "\uFF08\u4EC0\u4E48\u58F0\u97F3\uFF1F\uFF01\u632F\u52A8\u97F3\u54CD\uFF1F"
    charImage: {fileID: 0}
  - id: 6
    speakerName: "\u6211"
    speakingContent: "\u5916\u9762\u662F\u8C01\uFF1F"
    charImage: {fileID: 0}
  - id: 7
    speakerName: "\u201C\u5927\u4EBA\u7269\u201D"
    speakingContent: "\u4F60\u8FD9\u65B0\u8001\u677F\u600E\u4E48\u6562\u5BF9\u5927\u540D\u9F0E\u9F0E\u7684\u6211\u65E0\u793C\uFF1F\u6211\u53EF\u662F\u4EBA\u95F4\u6700\u73CD\u8D35\u7684\u5BA2\u4EBA\u4E4B\u4E00\uFF0C\u81EA\u5E26\u795E\u5723\u73AF\u9B45\u529B\u4F53\u8D28..."
    charImage: {fileID: 21300000, guid: c712538b6f3f0d843bb54ea81e4f71a2, type: 3}
  - id: 8
    speakerName: "\u6211"
    speakingContent: "\uFF08\u786E\u8BA4\u8FC7\u773C\u795E\uFF0C\u662F\u4E2A\u73B0\u4EE3\u4EBA\u3002"
    charImage: {fileID: 0}
  - id: 9
    speakerName: "\u6211"
    speakingContent: "\u90A3\u4E2A\uFF0C\u4F60\u5E72\u6270\u5230\u6211\u505A\u751F\u610F\u4E86\u3002"
    charImage: {fileID: 0}
  - id: 10
    speakerName: "\u201C\u5927\u4EBA\u7269\u201D"
    speakingContent: "\u5E72\u6270\uFF1F\u770B\u5230\u6211\u8FD9\u8EAB\u663E\u8D35\u7684\u7A7F\u642D\u5C31\u8BE5\u77E5\u9053\uFF0C\u4F60\u7684\u91D1\u4E3B\u5927\u4EBA\u6765\u4E86\uFF01"
    charImage: {fileID: 21300000, guid: c712538b6f3f0d843bb54ea81e4f71a2, type: 3}
  - id: 11
    speakerName: "\u201C\u5927\u4EBA\u7269\u201D"
    speakingContent: "\u554A\uFF0C\u8FD9\u91CC\u7684\u73AF\u5883\u8FDC\u4E0D\u5982\u6211\u4E4B\u524D\u53BB\u7684\u7C73\u57FA\u6797\u5341\u516B\u661F\u4E3B\u9898\u9910\u5385\uFF0C\u52C9\u4E3A\u5176\u96BE\u5403\u70B9\u597D\u4E86\u3002"
    charImage: {fileID: 21300000, guid: c712538b6f3f0d843bb54ea81e4f71a2, type: 3}
  - id: 12
    speakerName: "\u6211"
    speakingContent: "(\uFF40\u76BF\xB4\uFF03) \u4E0D\u559C\u6B22\u53EF\u4EE5\u4E0D\u7528\u52C9\u5F3A\u7684\uFF0C\u672C\u6765\u5C0F\u5E97\u4E5F\u6253\u7B97\u6253\u70CA\u4E86\u3002"
    charImage: {fileID: 0}
  - id: 13
    speakerName: "\u6211"
    speakingContent: "\u6211\u8FDB\u6765\u4E86\u3002"
    charImage: {fileID: 0}
  - id: 14
    speakerName: "\u7C89\u4E1D"
    speakingContent: "\u5076\u50CF\u6211\u4EEC\u559C\u6B22\u4F60\uFF01"
    charImage: {fileID: 0}
  - id: 15
    speakerName: "\u65C1\u767D"
    speakingContent: "\uFF08\u968F\u7740\u4ED6\u8D70\u8FDB\u5E97\u95E8\uFF0C\u4E00\u6279\u6279\u7684\u7C89\u4E1D\u517C\u98DF\u5BA2\u6D8C\u4E86\u8FDB\u6765"
    charImage: {fileID: 0}
  - id: 16
    speakerName: "\u6211"
    speakingContent: ....
    charImage: {fileID: 0}
  - id: 17
    speakerName: "\u6211"
    speakingContent: "\u6211\u7684\u5047\u671F\u554A\uFF01\uFF01"
    charImage: {fileID: 0}
  - id: 18
    speakerName: "\u201C\u5927\u4EBA\u7269\u201D"
    speakingContent: "\u653E\u5047\u6709\u4EC0\u4E48\u597D\u7684\uFF0C\u65E0\u804A\u53C8\u6F2B\u957F\uFF0C\u90FD\u5BB3\u5F97\u6211\u4E0D\u80FD\u4EAB\u53D7\u88AB\u7C89\u4E1D\u7C07\u62E5\u7684\u611F\u89C9\u4E86\u3002"
    charImage: {fileID: 21300000, guid: c712538b6f3f0d843bb54ea81e4f71a2, type: 3}
  - id: 19
    speakerName: "\u6211"
    speakingContent: "\uFF08\u4F60\u8FD9\u4EBA\u662F\u4E0D\u662F\u6709\u4EC0\u4E48\u5947\u602A\u7684\u7656\u597D..."
    charImage: {fileID: 0}
  - id: 20
    speakerName: "\u6211"
    speakingContent: "\u4F11\u606F\u3001\u653E\u677E\u3001\u63A2\u7D22\u3001\u89E3\u9501\u66F4\u591A\u73A9\u6CD5\uFF01\u4F60\u60F3\u60F3\u770B\uFF0C\u8FD9\u4E9B\u6D3B\u52A8\u54EA\u4E2A\u4E0D\u6BD4\u4E0A\u73ED\u8212\u670D\uFF1F"
    charImage: {fileID: 0}
  - id: 21
    speakerName: "\u201C\u5927\u4EBA\u7269\u201D"
    speakingContent: "\u8FD9\u4E9B\u90FD\u4E0D\u662F\u6211\u8BE5\u8003\u8651\u7684\u8303\u56F4\u3002"
    charImage: {fileID: 21300000, guid: c712538b6f3f0d843bb54ea81e4f71a2, type: 3}
  - id: 22
    speakerName: "\u201C\u5927\u4EBA\u7269\u201D"
    speakingContent: "\uFF08\u6492\u5E01\uFF09\u4F60\u7684\u5047\u671F\u6211\u4E70\u4E86,\u628A\u5E97\u91CC\u6700\u8D35\u6700\u6F02\u4EAE\u7684\u98DF\u7269\u7AEF\u4E0A\u6765\uFF0C\u4ECA\u5929\u5168\u573A\u8BA2\u5355\u6211\u53CC\u500D\u652F\u4ED8\u3002"
    charImage: {fileID: 21300000, guid: c712538b6f3f0d843bb54ea81e4f71a2, type: 3}
  - id: 23
    speakerName: "\u6211"
    speakingContent: "\uFF08\u53EF\u6076...\u5C45\u7136\u662F\u91D1\u5E01\u5417...\u90A3\u53EA\u80FD\u5C48\u670D\u4E86!"
    charImage: {fileID: 0}
