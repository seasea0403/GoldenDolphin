  lines:
  - id: 1
    speakerName: "\u6211"
    speakingContent: "\uFF08\u610F\u8BC6\u5728\u9ED1\u6697\u91CC\u6D6E\u6C89..."
    charImage: {fileID: 0}
  - id: 2
    speakerName: "\u6211"
    speakingContent: "\uFF08\u5934\u75DB...\u5934\u75DB..."
    charImage: {fileID: 0}
  - id: 3
    speakerName: "\u6211"
    speakingContent: "\u8FD9\u91CC...\u662F\u54EA\uFF1F"
    charImage: {fileID: 0}
  - id: 4
    speakerName: "\u201C\u5929\u624D\u201D"
    speakingContent: "\u5440\uFF0C\u547D\u5B9A\u4E4B\u4EBA\uFF0C\u4F60\u7EC8\u4E8E\u9192\u5566\u3002"
    charImage: {fileID: 21300000, guid: c29e35176be6c8e46945f36d250ca7c7, type: 3}
  - id: 5
    speakerName: "\u6211"
    speakingContent: "\u547D\uFF0C\u547D\u5B9A\u4E4B\u4EBA\uFF1F"
    charImage: {fileID: 0}
  - id: 6
    speakerName: "\u201C\u5929\u624D\u201D"
    speakingContent: "\u8BA9\u6211\u7528\u6700\u76F4\u767D\u6700\u4E0D\u7ED5\u5F2F\u5B50\u7684\u8BDD\u544A\u8BC9\u4F60\uFF0C\u4F60\u5DF2\u7ECF\u6210\u4E3A\u4E86\u8FD9\u5EA7\u7075\u5575\u98DF\u5802\u65B0\u4E00\u5C4A\u547D\u5B9A\u6253\u5DE5\u4EBA\u3002"
    charImage: {fileID: 21300000, guid: c29e35176be6c8e46945f36d250ca7c7, type: 3}
  - id: 7
    speakerName: "\u6211"
    speakingContent: "\u6253\u5DE5\uFF1F\u6211\uFF1F\u5728\u8FD9\u91CC\uFF1F"
    charImage: {fileID: 0}
  - id: 8
    speakerName: "\u6211"
    speakingContent: "\uFF08\u964C\u751F\u7684\u73AF\u5883\u3001\u5947\u88C5\u5F02\u670D\u7684\u4EBA...\u8FD8\u662F\u5148\u548C\u5BB6\u4EBA\u53D6\u5F97\u8054\u7CFB\u6BD4\u8F83\u597D\uFF0C\u514D\u5F97\u4ED6\u4EEC\u62C5\u5FC3\u4E86\u3002"
    charImage: {fileID: 0}
  - id: 9
    speakerName: "\u6211"
    speakingContent: "\uFF08\uFF01\uFF01\uFF01\u6CA1\u6709\u624B\u673A\uFF01"
    charImage: {fileID: 0}
  - id: 10
    speakerName: "\u6211"
    speakingContent: "\uFF08\u597D\u5728\u53E3\u888B\u91CC\u8FD8\u6709\u4E00\u70B9\u94B1..."
    charImage: {fileID: 0}
  - id: 11
    speakerName: "\u6211"
    speakingContent: "\u90A3\u4E2A...\u60A8\u53EF\u4EE5\u501F\u6211\u4E00\u4E0B\u7535\u8BDD\u5417\uFF1F\u6211\u60F3\u8054\u7CFB\u4E00\u4E0B\u5BB6\u4EBA\u3002\u6211\u53EF\u4EE5\u652F\u4ED8\u916C\u52B3\u7684\u3002"
    charImage: {fileID: 0}
  - id: 12
    speakerName: "\u201C\u5929\u624D\u201D"
    speakingContent: "\u7535\u8BDD\uFF1F\u65B0\u6F6E\u8D27\uFF01\u6211\u6CA1\u6709\u3002\u6211\u6700\u8FD1\u5728\u5356\u84B8\u6C7D\u5927\u8C61\u949F\uFF0C\u611F\u5174\u8DA3\u7684\u8BDD\u7ED9\u4F60\u6253\u6298\uFF01"
    charImage: {fileID: 21300000, guid: c29e35176be6c8e46945f36d250ca7c7, type: 3}
  - id: 13
    speakerName: "\u6211"
    speakingContent: "\u4E0D\u7528\u4E86\uFF0C\u8C22\u8C22\u3002\u90A3\u6211\u53EF\u4EE5\u95EE\u60A8\u4E00\u4E9B\u95EE\u9898\u5417\uFF1F"
    charImage: {fileID: 0}
  - id: 14
    speakerName: "\u201C\u5929\u624D\u201D"
    speakingContent: "\u5F53\u7136\u53EF\u4EE5\uFF01\u8EAB\u4E3A\u539F\u4F4F\u6C11\uFF0C\u6211\u77E5\u9053\u7684\u60C5\u62A5\u80AF\u5B9A\u6BD4\u4F60\u4E00\u4E2A\u5F02\u90A6\u4EBA\u591A\u3002"
    charImage: {fileID: 21300000, guid: c29e35176be6c8e46945f36d250ca7c7, type: 3}
  - id: 15
    speakerName: "\u201C\u5929\u624D\u201D"
    speakingContent: "\u6211\u53EF\u4EE5\u544A\u8BC9\u4F60\u5F88\u591A\u5173\u4E8E\u8FD9\u91CC\u7684\u7EBF\u7D22\uFF0C\u81F3\u4E8E\u916C\u52B3\uFF0C\u6765\u7ED9\u6211\u505A\u996D\u5427\uFF01\u6211\u73B0\u5728\u5F88\u997F\u3002"
    charImage: {fileID: 21300000, guid: c29e35176be6c8e46945f36d250ca7c7, type: 3}
  - id: 16
    speakerName: "\u6211"
    speakingContent: "\uFF08\u8FD9\u4E5F\u592A\u8349\u7387\u4E86\u5427\uFF01\u6211\u4E5F\u5B8C\u5168\u4E0D\u8BB0\u5F97\u81EA\u5DF1\u624B\u827A\u600E\u4E48\u6837..."
    charImage: {fileID: 0}
  - id: 17
    speakerName: "\u201C\u5929\u624D\u201D"
    speakingContent: "\u5FEB\u70B9\u5FEB\u70B9\uFF0C\u6211\u7684\u8010\u5FC3\u662F\u6709\u9650\u7684\u5594\u3002\u3010\u663E\u5316\u8010\u5FC3\u503C\u3011"
    charImage: {fileID: 21300000, guid: c29e35176be6c8e46945f36d250ca7c7, type: 3}
  - id: 18
    speakerName: "\u201C\u5929\u624D\u201D"
    speakingContent: "\u5148\u70B9\u51FB\u914D\u65B9\u67E5\u770B\u83DC\u54C1\u505A\u6CD5\u3002\u3010\u5F15\u5BFC\u70B9\u51FB\u914D\u65B9Btn\u3011"
    charImage: {fileID: 21300000, guid: c29e35176be6c8e46945f36d250ca7c7, type: 3}
  - id: 19
    speakerName: "\u201C\u5929\u624D\u201D"
    speakingContent: "\u8BB0\u4F4F\u4E86\u5417\uFF1F\u6CA1\u8BB0\u4F4F\u4E5F\u6CA1\u5173\u7CFB\uFF0C\u53EF\u4EE5\u968F\u65F6\u70B9\u5F00\u518D\u67E5\u770B\u3002\u3010\u5F15\u5BFC\u70B9\u51FB\u5173\u95ED\u914D\u65B9\u9762\u677F\u3011"
    charImage: {fileID: 21300000, guid: c29e35176be6c8e46945f36d250ca7c7, type: 3}
  - id: 20
    speakerName: "\u201C\u5929\u624D\u201D"
    speakingContent: "\u73B0\u5728\u524D\u5F80\u5907\u83DC\u533A\u3002\u3010\u5F15\u5BFC\u70B9\u51FB\u5907\u83DC\u533A\u3011"
    charImage: {fileID: 21300000, guid: c29e35176be6c8e46945f36d250ca7c7, type: 3}
  - id: 21
    speakerName: "\u201C\u5929\u624D\u201D"
    speakingContent: "\u98DF\u6750\u96C6\u4E2D\u5728\u98DF\u6750\u683C\u3001\u51B0\u7BB1\u548C\u6A71\u67DC\u91CC\uFF0C\u70B9\u51FB\u67E5\u770B\u3002\u628A\u9700\u8981\u7684\u98DF\u6750\u62D6\u5230\u83DC\u677F\u6216\u69A8\u6C41\u673A\u4E0A\u5904\u7406\u5427\uFF01"
    charImage: {fileID: 21300000, guid: c29e35176be6c8e46945f36d250ca7c7, type: 3}
  - id: 22
    speakerName: "\u201C\u5929\u624D\u201D"
    speakingContent: "\u6709\u4E9B\u98DF\u6750\u9700\u8981\u4E8C\u6B21\u5904\u7406\u54E6\uFF0C\u5B8C\u6210\u5904\u7406\u7684\u98DF\u6750\u4F1A\u51FA\u73B0\u5728\u70F9\u8C03\u533A\u67DC\u5B50\u4E0A\u3002"
    charImage: {fileID: 21300000, guid: c29e35176be6c8e46945f36d250ca7c7, type: 3}
  - id: 23
    speakerName: "\u201C\u5929\u624D\u201D"
    speakingContent: "\u70B9\u51FB\u8FDB\u5165\u70F9\u8C03\u533A\u3002\u3010\u5F15\u5BFC\u70B9\u51FB\u70F9\u8C03\u533A\u3011"
    charImage: {fileID: 21300000, guid: c29e35176be6c8e46945f36d250ca7c7, type: 3}
  - id: 24
    speakerName: "\u201C\u5929\u624D\u201D"
    speakingContent: "\u70B9\u51FB\u9009\u9505\u6309\u94AE\uFF0C\u4E3A\u8BA2\u5355\u9009\u62E9\u4E00\u4E2A\u5408\u9002\u7684\u9505\u3002\u3010\u5F15\u5BFC\u70B9\u51FB\u9009\u9505\u6309\u94AE\u3011"
    charImage: {fileID: 21300000, guid: c29e35176be6c8e46945f36d250ca7c7, type: 3}
  - id: 25
    speakerName: "\u201C\u5929\u624D\u201D"
    speakingContent: "\u628A\u6240\u6709\u6750\u6599\u90FD\u62D6\u8FDB\u53A8\u5177\uFF0C\u5B8C\u6210\u64CD\u4F5C\u540E\u5F00\u706B\uFF0C\u7B49\u5F85\u8FDB\u5EA6\u6761\u6765\u5230\u9608\u503C\u3002\u5C0F\u5FC3\u4E0D\u8981\u70E7\u7CCA\u4E86\uFF01"
    charImage: {fileID: 21300000, guid: c29e35176be6c8e46945f36d250ca7c7, type: 3}
  - id: 26
    speakerName: "\u201C\u5929\u624D\u201D"
    speakingContent: "\u6D41\u53E3\u6C34\u4E86\uFF01\u73B0\u5728\u62D6\u51FA\u6210\u54C1\u83DC\uFF0C\u653E\u5728\u8FD9\u91CC\u3002\u3010\u663E\u5316\u9910\u57AB\u3011"
    charImage: {fileID: 21300000, guid: c29e35176be6c8e46945f36d250ca7c7, type: 3}
  - id: 27
    speakerName: "\u201C\u5929\u624D\u201D"
    speakingContent: "\u70B9\u51FB\u9001\u9910\u94C3\uFF0C\u83DC\u54C1\u6D88\u5931\u8BA2\u5355\u5C31\u662F\u5B8C\u6210\u4E86\u3002\u3010\u663E\u5316\u9001\u9910\u94C3\u3011"
    charImage: {fileID: 21300000, guid: c29e35176be6c8e46945f36d250ca7c7, type: 3}
