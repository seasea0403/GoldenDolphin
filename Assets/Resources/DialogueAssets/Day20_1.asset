  lines:
  - id: 1
    speakerName: "\u201C\u5929\u624D\u201D"
    speakingContent: "\u597D\u4E45\u4E0D\u89C1\uFF01\u6211\u770B\u5230\u4F60\u522B\u7684\u5730\u65B9\uFF0C\u6709\u6CA1\u6709\u89C1\u5230\u7279\u522B\u6F02\u4EAE\u7684\u5929\u4F7F\u548C\u4EBA\u9AD8\u9A6C\u5927\u7684\u602A\u7269\uFF1F"
    charImage: {fileID: 21300000, guid: c29e35176be6c8e46945f36d250ca7c7, type: 3}
  - id: 2
    speakerName: "\u6211"
    speakingContent: "\u6709\u7684\u6709\u7684\uFF01\u7B80\u76F4\u4E0D\u6562\u76F8\u4FE1\uFF0C\u6211\u770B\u5230\u7684\u6EE1\u8DB3\u4E86\u6240\u6709\u7ED8\u672C\u4E0A\u5BF9\u5929\u5802\u5730\u72F1\u7684\u60F3\u8C61\u3002"
    charImage: {fileID: 0}
  - id: 3
    speakerName: "\u6211"
    speakingContent: "\u544A\u8BC9\u4E86\u6211\u8FD9\u4E48\u591A\uFF0C\u5929\u624D\u5C0F\u59D0\u5BF9\u4E0D\u6127\u662F\u9760\u8C31\u7684\u524D\u8F88\u554A\u3002"
    charImage: {fileID: 0}
  - id: 4
    speakerName: "\u201C\u5929\u624D\u201D"
    speakingContent: .....
    charImage: {fileID: 21300000, guid: c29e35176be6c8e46945f36d250ca7c7, type: 3}
  - id: 5
    speakerName: "\u6211"
    speakingContent: "\u600E\u4E48\u4E86\uFF0C\u5929\u624D\u5C0F\u59D0\uFF1F"
    charImage: {fileID: 0}
  - id: 6
    speakerName: "\u201C\u5929\u624D\u201D"
    speakingContent: "\u795D\u8D3A\u4F60\u5728\u8FD9\u91CC\u987A\u5229\u5B9A\u5C45!"
    charImage: {fileID: 21300000, guid: c29e35176be6c8e46945f36d250ca7c7, type: 3}
  - id: 7
    speakerName: "\u6211"
    speakingContent: "\uFF08\u603B\u89C9\u5F97\u5979\u539F\u672C\u8FD8\u6709\u4EC0\u4E48\u60F3\u8BF4..."
    charImage: {fileID: 0}
  - id: 8
    speakerName: "\u201C\u5929\u624D\u201D"
    speakingContent: "\u4ECA\u5929\u53EF\u80FD\u662F\u6211\u6700\u540E\u4E00\u6B21\u7528\u9910\u4E86\u54E6\uFF0C\u6211\u6253\u7B97\u6765\u4E00\u573A\u8D85\u8FDC\u7684\u65C5\u884C\u3002"
    charImage: {fileID: 21300000, guid: c29e35176be6c8e46945f36d250ca7c7, type: 3}
  - id: 9
    speakerName: "\u6211"
    speakingContent: "\u65C5\u884C\uFF1F\u4F60\u6253\u7B97\u53BB\u54EA\u91CC\u5440\uFF1F"
    charImage: {fileID: 0}
  - id: 10
    speakerName: "\u201C\u5929\u624D\u201D"
    speakingContent: "\u53BB\u8FDC\u4E00\u70B9\u5427\uFF0C\u5728\u8FD9\u5446\u592A\u4E45\u4E86\uFF0C\u611F\u89C9\u81EA\u5DF1\u90FD\u8981\u53D8\u6210\u8001\u53E4\u8463\u4E86\u3002"
    charImage: {fileID: 21300000, guid: c29e35176be6c8e46945f36d250ca7c7, type: 3}
  - id: 11
    speakerName: "\u201C\u5929\u624D\u201D"
    speakingContent: "\u8FD9\u5EA7\u98DF\u5802\u7684\u672A\u6765\u5C31\u4EA4\u7ED9\u4F60\u4E86\uFF0C\u795D\u4F60\u597D\u8FD0\uFF01"
    charImage: {fileID: 21300000, guid: c29e35176be6c8e46945f36d250ca7c7, type: 3}
